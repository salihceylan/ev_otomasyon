# ==============================================================================
# AHBU Ev Otomasyonu - Sunucu ortam degiskenleri (ORNEK / YER TUTUCU)
# ==============================================================================
# Bu dosya yalnizca degisken ADLARINI ve bicimlerini gosterir. Gercek degerler `.env`
# dosyasina yazilir ve `.env` DEPOYA GIRMEZ (.gitignore). Sir uretmek icin ornek:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Zorunlu (Z) degerler eksikse sunucu BASLAMAZ (fail-closed). Bkz. docs/CONTRACTS.md §6.

NODE_ENV=production
PORT=5000
# Yalnizca yerel vekil (nginx) erisir. Disariya acmayin.
BIND_HOST=127.0.0.1
# Express "trust proxy": nginx ayni makinedeyse loopback.
TRUST_PROXY=loopback

# (Z) PostgreSQL baglantisi (uretimdeki kapi sistemi veritabani DEGIL!)
DATABASE_URL=postgres://KULLANICI:PAROLA@127.0.0.1:5434/ev_otomasyon

# (Z) JWT imzalama siri - en az 32 karakter, rastgele.
JWT_SECRET=
# JWT "iss" claim'i (opsiyonel)
JWT_ISSUER=ahbu-ev-otomasyon

# (Z) PIN / OTP ozetleri icin HMAC anahtari - en az 32 karakter, rastgele.
#     DIKKAT: degistirilirse mevcut kurulum PIN ozetleri gecersiz olur (bkz. SECRET_ROTATION).
PIN_PEPPER=

# (Z) Cihaz yerel anahtari sifreleme anahtari: 32 bayt = 64 onaltilik (hex) karakter.
LOCAL_KEY_SECRET=

# (Z) MQTT koprusu (backend superuser kimligi)
MQTT_HOST=127.0.0.1
MQTT_PORT=1884
MQTT_BACKEND_USER=backend_service
MQTT_BACKEND_PASS=
# (Z) Istemcilere bildirilen genel broker adresi
MQTT_PUBLIC_HOST=evotomasyon.gudeteknoloji.com.tr
MQTT_PUBLIC_PORT=8884

# EMQX REST (baglanti atma / kick) - opsiyonel; yoksa atlanir, uyari loglanir.
EMQX_API_URL=
EMQX_API_KEY=
EMQX_API_SECRET=

# Google / Apple girisi - ilgili ozellik kullanilacaksa zorunlu (virgulle ayrilmis istemci kimlikleri).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Fabrika/makine entegrasyonu icin API anahtari - opsiyonel. Yoksa veya 32 karakterden
# kisaysa API anahtari yolu KAPALIDIR (envanter islemleri super_user JWT ile yapilir).
ADMIN_API_KEY=

# Tarayici kokenleri (virgulle). Bossa tarayici kokenleri reddedilir; mobil istemci etkilenmez.
CORS_ORIGINS=

# Uygulama genel adresi (sifre sifirlama baglantisi / QR claim baglantisi)
APP_PUBLIC_URL=https://evotomasyon.gudeteknoloji.com.tr

# E-posta (sifre sifirlama, hesap etkinlestirme, kurulum OTP'si)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# YALNIZCA GELISTIRME: OTP/kodlari yanitta dondurur. Uretimde (NODE_ENV=production) YOK SAYILIR.
ALLOW_DEBUG_OTP=false

# YALNIZCA URETIM DISI QA (A16): sure kisaltma override'lari (saniye). Uretimde YOK SAYILIR;
# hicbir ortamda varsayilandan uzun olamaz, alt sinir 10 sn.
#ACCESS_TOKEN_TTL_SEC=900
#SERVICE_SESSION_TTL_SEC=7200
#REFRESH_TOKEN_TTL_SEC=2592000
#OTP_TTL_SEC=300

# Kimlik dogrulama onbellegi (ms, en fazla 30000)
#AUTH_CACHE_TTL_MS=30000

# ==============================================================================
# Altyapi (docker-compose.yml, EMQX, yonetim betikleri) - C paketi
# ==============================================================================
# docker-compose ${VAR:?} ile bunlari ZORUNLU kilar; yoksa acik hatayla durur.
POSTGRES_USER=ev_admin
POSTGRES_DB=ev_otomasyon
# DIKKAT: yalnizca ILK hacim olusturmada uygulanir (mevcut hacimde parolayi eslestirin veya ALTER ROLE).
POSTGRES_PASSWORD=
EMQX_DASHBOARD_PASSWORD=
# EMQX'in kimlik/ACL tablolarini okudugu en az yetkili DB rolu (scripts/create_db_roles.sql olusturur).
EMQX_AUTHDB_USER=emqx_authn
EMQX_AUTHDB_PASSWORD=
# Let's Encrypt sertifika dizini (icinde fullchain.pem + privkey.pem); EMQX'e YALNIZ salt-okunur baglanir.
EMQX_CERT_DIR=
EMQX_TLS_BIND_ADDR=0.0.0.0
EMQX_NODE_COOKIE=

# Kopru (mqtt_bridge) opsiyonel ayarlari
#MQTT_TLS=false
#MQTT_CLIENT_ID=ev-backend-bridge
# Cihaz bu sure state gondermezse cevrimdisi sayilir (sn, en az 30)
#MQTT_OFFLINE_AFTER_SEC=120
#MQTT_RECONNECT_MIN_MS=1000
#MQTT_RECONNECT_MAX_MS=30000
#MQTT_PUBLISH_TIMEOUT_MS=5000
# Uc nokta yerlesim esitleme (WP-L, CONTRACTS 2.4b): panonun state'te bildirdigi role tip/ad bilgisinden
# endpoints satirlarini uzlastirir. Varsayilan ACIK. Kapatmak icin: off | 0 | false
#ENDPOINT_LAYOUT_SYNC=off

# Yonetim betikleri (scripts/*.js) - YALNIZCA komut satirinda, o an icin verin; kalici .env'e yazmayin:
#   MIGRATE_CONFIRM=<hedef veritabani adi>       scripts/migrate.js (yanlis DB'ye calismayi onler)
#   ALLOW_DEV_SEEDS=true DEV_SEED_PASSWORD=... DEV_SEED_PIN=...   scripts/seed_dev.js (NODE_ENV=production'da reddeder)
#   SUPER_USER_EMAIL=... SUPER_USER_PASSWORD=...  scripts/create_super_user.js (ilk yonetici; parola >= 12 karakter)
#   LEGACY_MQTT_USER=... LEGACY_MQTT_PASS=...     scripts/upgrade_legacy_mqtt_user.js (eski paylasilan kimligi bcrypt'e yukseltir)

# --- Gece hatirlatmasi (push) -------------------------------------------------
# FCM (HTTP v1): proje kimligi + servis hesabi anahtarinin DOSYA YOLU (anahtari ortam degiskenine gommeyin;
# dosya git'e / imaja girmez, salt okunur baglanir). Ikisi de yoksa push KAPALI, uygulama ici yedek calisir.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm_service_account.json
# Kapatma anahtari (taninmayan deger = KAPALI). Varsayilan: true
# PEACE_REMINDER_ENABLED=true
# true ise kayit tutulur ama push GITMEZ (ilk gece bununla dogrulayin; taninmayan deger = ACIK). Varsayilan: false
# PEACE_REMINDER_DRY_RUN=true
# Virgullu ev UUID'leri: doluysa yalnizca bu evler (kademeli acilis). Bos = hepsi
# PEACE_REMINDER_HOME_ALLOWLIST=
# Hedef saatten sonra kac dakika boyunca denenir (1-720). Varsayilan: 60
# PEACE_CATCHUP_MIN=60

# --- Uygulama baglantisi dogrulama dosyalari (Android App Links / iOS Universal Links) ---
# GET /.well-known/assetlinks.json depodaki surum imza anahtari parmak izini HER ZAMAN yayinlar. Buraya yalnizca
# EK SHA-256 parmak izleri yazilir (virgulle; 32 bayt, iki nokta ayrimli onaltilik AA:BB:..; ornegin Google Play
# uygulama imzalama anahtari). Gecersiz deger atlanir, acilista bir kez uyari loglanir. Parmak izi gizli degildir.
ANDROID_APP_LINK_CERT_SHA256=
# Apple Developer Team ID (10 karakter, A-Z / 0-9). Bos ya da gecersizse /.well-known/apple-app-site-association
# ve /apple-app-site-association 404 doner. Degisince sunucu yeniden baslatilir. Bkz. docs/CONTRACTS.md §3k.
APPLE_TEAM_ID=
