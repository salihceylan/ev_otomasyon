+      await tester.pump();
+      await tester.pump();
+      expect(
+        tester.widget<TextButton>(find.byKey(_enable)).onPressed,
+        isNotNull,
+      );
+    });
+  });
+
+  group('tema, ölçek, erişilebilirlik', () {
