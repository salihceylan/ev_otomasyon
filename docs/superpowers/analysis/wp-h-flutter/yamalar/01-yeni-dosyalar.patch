+      expect(PeaceNotice.fromSettings(_settings(), now: created.add(const Duration(hours: 14))), isNotNull);
+      expect(PeaceNotice.fromSettings(_settings(), now: created.add(const Duration(hours: 14, seconds: 1))), isNull);
