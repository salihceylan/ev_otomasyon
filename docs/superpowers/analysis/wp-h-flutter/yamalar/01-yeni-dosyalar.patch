+/// Yerel [DateTime] -> sunucunun UTC ISO metni (saat dilimine bağlı kalmasın).
+String _iso(DateTime local) => local.toUtc().toIso8601String();
+
+Map<String, dynamic> _v2({
+  DateTime? created,
+  String status = 'sent',
+  DateTime? resolvedAt,
+  int? lights = 2,
+  int? shutters = 1,
+  int? online = 1,
+  int? total = 2,
+  bool? stale = false,
+  bool withLast = true,
