+        // aynı bildirimin push kopyasıyla aynı anahtar: ikisi birden afiş çıkarmaz
+        expect(notice.dedupeKey, PeaceNotice.tryParse(_data(), now: _morning)!.dedupeKey);
+      },
+    );
+
+    test('sayılar gece kaydından değil CANLI veriden gelir', () {
