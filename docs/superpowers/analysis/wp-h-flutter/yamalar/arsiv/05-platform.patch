+import android.app.NotificationChannel
+import android.app.NotificationManager
 import android.os.Build
@@ -11,2 +13,3 @@ class MainActivity : FlutterFragmentActivity() {
         super.onCreate(savedInstanceState)
+        createPeaceReminderChannel()
         // Android 12+ (API 31+) siyah SplashScreen beklemesini sonlandır,
@@ -19,2 +22,18 @@ class MainActivity : FlutterFragmentActivity() {
     }
+
+    // Sunucu bildirimde channel_id = peace_reminder gönderir; kanal uygulamada yoksa Android
+    // sistem varsayılan kanalına düşer ve hatırlatma sessiz/düşük öncelikli görünebilir.
+    // Kanallar API 26 ile geldiği için daha eski sürümlerde atlanır; yeniden oluşturmak zararsızdır.
+    private fun createPeaceReminderChannel() {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        val manager = getSystemService(NotificationManager::class.java) ?: return
+        val channel = NotificationChannel(
+            "peace_reminder",
+            "Gece hatırlatması",
+            NotificationManager.IMPORTANCE_HIGH,
+        ).apply {
+            description = "Gece saatinde açık kalan lamba ve panjurlar için hatırlatma."
+        }
+        manager.createNotificationChannel(channel)
+    }
 }
